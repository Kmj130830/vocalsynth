QWidget{background:#17191c;color:#e5e7eb;font-family:"Segoe UI";}QToolBar,QMenuBar,QStatusBar{background:#202328;border:0;}QMenu{background:#202328;color:#e5e7eb;}QMenu::item:selected{background:#343941;}QLineEdit,QSpinBox,QDoubleSpinBox,QPlainTextEdit{background:#121417;border:1px solid #3b414a;color:#e5e7eb;padding:4px;}QPushButton{background:#2a2f36;border:1px solid #454b55;padding:5px 10px;}QPushButton:hover{background:#353b44;}QDockWidget::title{background:#202328;padding:6px;}QListWidget{background:#15171a;border:0;}QListWidget::item:selected{background:#3a5f95;}
